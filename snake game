import random

# Snakes and ladders positions
snakes = {
    99: 54,
    70: 55,
    52: 42,
    25: 2,
    95: 72
}

ladders = {
    6: 25,
    11: 40,
    17: 69,
    46: 90,
    60: 85
}

# Player positions
player1 = 0
player2 = 0

def roll_dice():
    return random.randint(1, 6)

def move_player(position, dice):
    position += dice

    if position > 100:
        return position - dice

    if position in snakes:
        print("🐍 Oh no! Bitten by a snake!")
        position = snakes[position]

    elif position in ladders:
        print("🪜 Yay! Climbed a ladder!")
        position = ladders[position]

    return position


while True:

    input("Player 1 press Enter to roll dice...")
    dice = roll_dice()
    print("Player 1 rolled:", dice)

    player1 = move_player(player1, dice)
    print("Player 1 position:", player1)

    if player1 == 100:
        print("🎉 Player 1 Wins!")
        break

    input("Player 2 press Enter to roll dice...")
    dice = roll_dice()
    print("Player 2 rolled:", dice)

    player2 = move_player(player2, dice)
    print("Player 2 position:", player2)

    if player2 == 100:
        print("🎉 Player 2 Wins!")
        break
